# ─── DATABASE ─────────────────────────────────────────────────────────────────
# For Vercel Postgres / Supabase / Neon / Railway
DATABASE_URL="postgresql://user:password@host:5432/litesocial?sslmode=require"
# Some providers need a direct (non-pooled) URL for Prisma migrations
DIRECT_URL="postgresql://user:password@host:5432/litesocial?sslmode=require"

# ─── REDIS ────────────────────────────────────────────────────────────────────
# For Upstash Redis (recommended for Vercel serverless)
REDIS_URL="rediss://default:your-token@your-endpoint.upstash.io:6379"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 64
JWT_SECRET="your-256-bit-secret-here-change-this-in-production"

# ─── APP ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ─── EMAIL (Resend) ───────────────────────────────────────────────────────────
# Sign up at resend.com — free tier: 3000 emails/month
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="LiteSocial <noreply@yourdomain.com>"

# ─── LITECOIN (BlockCypher) ───────────────────────────────────────────────────
# Free tier: 200 req/hour. Sign up at blockcypher.com
BLOCKCYPHER_TOKEN="your-blockcypher-token"
# Set to "ltc/test3" for testnet, "ltc/main" for mainnet
BLOCKCYPHER_NETWORK="ltc/test3"
# Your deployed URL + /api/subscriptions/webhook (must be public for webhooks)
BLOCKCYPHER_WEBHOOK_URL="https://yourdomain.vercel.app/api/subscriptions/webhook"

# ─── LITECOIN HD WALLET ───────────────────────────────────────────────────────
# Generate offline using: https://iancoleman.io/bip39/
# NEVER commit the private key. Only xpub is needed at runtime for deposit addresses.
LTC_MASTER_XPUB="xpub6C..."

# ─── IPFS (Pinata) ────────────────────────────────────────────────────────────
# Sign up at pinata.cloud — free tier: 1GB
PINATA_API_KEY="your-pinata-api-key"
PINATA_SECRET_KEY="your-pinata-secret-key"
NEXT_PUBLIC_PINATA_GATEWAY="https://gateway.pinata.cloud"

# ─── COINGECKO (LTC price) ────────────────────────────────────────────────────
# Optional — free tier works without an API key
COINGECKO_API_KEY=""
